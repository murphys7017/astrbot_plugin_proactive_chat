{
    "admin_users": {
        "description": "🔐 插件管理员列表",
        "type": "list",
        "default": null
    },
    "friend_settings": {
        "description": "👤 私聊主动策略",
        "type": "object",
        "items": {
            "enable": {
                "description": "启用私聊主动策略",
                "type": "bool",
                "default": true
            },
            "session_list": {
                "description": "私聊会话 UMO 列表",
                "type": "list",
                "default": []
            },
            "auto_trigger_settings": {
                "description": "🤖 自动主动事实设置",
                "type": "object",
                "items": {
                    "enable_auto_trigger": {
                        "description": "✅ 启用空闲触发",
                        "type": "bool",
                        "default": false,
                        "hint": "仅负责在空闲后提交事实，是否表达由 Personal Runtime 决定。"
                    },
                    "auto_trigger_after_minutes": {
                        "description": "⏱️ 空闲检查时间（分钟）",
                        "type": "int",
                        "default": 5,
                        "slider": {
                            "min": 1,
                            "max": 1440,
                            "step": 1
                        }
                    }
                }
            },
            "schedule_settings": {
                "description": "🕒 私聊调度设置",
                "type": "object",
                "items": {
                    "min_interval_minutes": {
                        "description": "最小调度间隔（分钟）",
                        "type": "int",
                        "default": 30,
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "max_interval_minutes": {
                        "description": "最大调度间隔（分钟）",
                        "type": "int",
                        "default": 600,
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "enable_quiet_hours": {
                        "description": "启用免打扰时段",
                        "type": "bool",
                        "default": true
                    },
                    "quiet_hours": {
                        "description": "免打扰时段",
                        "type": "string",
                        "default": "1-7"
                    }
                }
            }
        }
    },
    "group_settings": {
        "description": "👥 群聊主动策略",
        "type": "object",
        "items": {
            "enable": {
                "description": "启用群聊主动策略",
                "type": "bool",
                "default": false
            },
            "session_list": {
                "description": "群聊会话 UMO 列表",
                "type": "list",
                "default": []
            },
            "auto_trigger_settings": {
                "description": "🤖 自动主动事实设置",
                "type": "object",
                "items": {
                    "enable_auto_trigger": {
                        "description": "✅ 启用空闲触发",
                        "type": "bool",
                        "default": false,
                        "hint": "仅负责在空闲后提交事实，是否表达由 Personal Runtime 决定。"
                    },
                    "auto_trigger_after_minutes": {
                        "description": "⏱️ 空闲检查时间（分钟）",
                        "type": "int",
                        "default": 10,
                        "slider": {
                            "min": 1,
                            "max": 1440,
                            "step": 1
                        }
                    }
                }
            },
            "group_idle_trigger_minutes": {
                "description": "群聊沉默时间（分钟）",
                "type": "int",
                "default": 30,
                "slider": {
                    "min": 1,
                    "max": 1440,
                    "step": 10
                }
            },
            "schedule_settings": {
                "description": "🕒 群聊调度设置",
                "type": "object",
                "items": {
                    "min_interval_minutes": {
                        "description": "最小调度间隔（分钟）",
                        "type": "int",
                        "default": 90,
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "max_interval_minutes": {
                        "description": "最大调度间隔（分钟）",
                        "type": "int",
                        "default": 360,
                        "slider": {
                            "min": 1,
                            "max": 2880,
                            "step": 30
                        }
                    },
                    "enable_quiet_hours": {
                        "description": "启用免打扰时段",
                        "type": "bool",
                        "default": true
                    },
                    "quiet_hours": {
                        "description": "免打扰时段",
                        "type": "string",
                        "default": "2-6"
                    }
                }
            }
        }
    }
}
